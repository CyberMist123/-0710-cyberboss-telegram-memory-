# Copy this file to your private config directory as .env.
# Values are placeholders; do not commit real tokens or local private paths.

CYBERBOSS_CONFIG_DIR=<CONFIG_DIR>
CYBERBOSS_STATE_DIR=<STATE_DIR>
CYBERBOSS_WORKSPACE=<WORKSPACE>
CYBERBOSS_PROMPT_FILE=<REPO_ROOT>/templates/weixin-instructions.md

CYBERBOSS_CHANNEL=telegram
CYBERBOSS_RUNTIME=claudecode
CYBERBOSS_CLAUDE_COMMAND=claude
CYBERBOSS_CLAUDE_MODEL=<MODEL>
CYBERBOSS_CLAUDE_PERMISSION_MODE=default
CYBERBOSS_CLAUDE_CONFIG_DIR=<CLAUDE_CONFIG_DIR>
# Leave blank to follow the host timezone; set an IANA name to override. Affects sleep quiet hours and AI time reporting.
CYBERBOSS_TIMEZONE=
DEEPSEEK_API_KEY=
# Never commit a value here. Export DEEPSEEK_API_KEY in the launching process.

CYBERBOSS_TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>
CYBERBOSS_TELEGRAM_ALLOWED_USER_IDS=<TELEGRAM_ALLOWED_USER_IDS>
CYBERBOSS_MEDIA_INBOX_MAX_BYTES=20971520
# Local Whisper is opt-in and never downloads a model automatically.
CYBERBOSS_LOCAL_WHISPER_ENABLED=false
# CYBERBOSS_LOCAL_WHISPER_PYTHON=python
# CYBERBOSS_LOCAL_WHISPER_MODEL=<LOCAL_WHISPER_MODEL_DIR>
# CYBERBOSS_LOCAL_WHISPER_DEVICE=cpu
# CYBERBOSS_LOCAL_WHISPER_COMPUTE_TYPE=int8
# CYBERBOSS_LOCAL_WHISPER_TIMEOUT_MS=120000
# CYBERBOSS_LOCAL_WHISPER_MAX_INPUT_BYTES=20971520
# CYBERBOSS_LOCAL_WHISPER_MAX_AUDIO_SECONDS=180
# CYBERBOSS_LOCAL_WHISPER_MAX_OUTPUT_CHARS=4000
# CYBERBOSS_LOCAL_WHISPER_MAX_STDERR_CHARS=4000

CYBERBOSS_LOG_DIR=<STATE_DIR>/logs
CYBERBOSS_DASHBOARD_HOST=127.0.0.1
CYBERBOSS_DASHBOARD_PORT=<DASHBOARD_PORT>
CYBERBOSS_LOCATION_PORT=<LOCATION_PORT>
CYBERBOSS_BACKUP_DIR=<BACKUP_DIR>

# Phase 1 safety defaults: legacy memory side effects stay off unless explicitly re-enabled.
CYBERBOSS_MEMORY_RETRIEVAL=0
CYBERBOSS_MEMORY_BACKGROUND_WRITE=0
CYBERBOSS_MEMORY_REPLY_TRANSFORM=0
CYBERBOSS_INCLUDE_OPERATIONS_PROMPT=0
CYBERBOSS_INCLUDE_LEGACY_MEMORY_RELAYS=0
CYBERBOSS_DESIRE_DRIVEN=0
CYBERBOSS_DESIRE_LOOP_MINIMAL_ENABLED=0

# P0 closeout/liveness is deliberately off by default. These jobs use the
# existing ContinuityPipeline, writer lease, system-message queue, and
# Telegram delivery path; they never alter the ordinary chat path when off.
CYBERBOSS_NIGHTLY_CLOSEOUT_ENABLED=false
# Valid modes: evidence, shadow, auto. Default is evidence; only auto writes canonical history.
CYBERBOSS_NIGHTLY_MODE=evidence
CYBERBOSS_NIGHTLY_CLOSEOUT_HOUR=4
CYBERBOSS_NIGHTLY_CLOSEOUT_MINUTE=30
CYBERBOSS_AUTOMATION_TIMEZONE=Australia/Sydney
CYBERBOSS_CANON_LIVENESS_ENABLED=false
CYBERBOSS_CANON_LIVENESS_THRESHOLD_HOURS=48
CYBERBOSS_RECALL_LIVENESS_ENABLED=false
CYBERBOSS_RECALL_LIVENESS_THRESHOLD_HOURS=48
CYBERBOSS_LIVENESS_STARTUP_GRACE_MINUTES=30
CYBERBOSS_LIVENESS_ALERT_COOLDOWN_HOURS=24
CYBERBOSS_LIVENESS_RECOVERY_ENABLED=true
CYBERBOSS_CLAUDE_TRANSCRIPT_DIR=<CLAUDE_TRANSCRIPT_DIR>
CYBERBOSS_MEMORY_DIR=<STATE_DIR>/memory

# Phase 1 switch safety: export this in the CURRENT PowerShell process before running
# phase1-switch.ps1. The switch preflight intentionally does not load this value from .env.
# $env:CYBERBOSS_NON_TELEGRAM_PID_ALLOWLIST='<WECHAT_CYBERBOSS_PID>'

# Optional external/archive features.
CYBERBOSS_ARCHIVE_BUILDER_PATH=<ARCHIVE_BUILDER_PATH>
CYBERBOSS_ARCHIVE_SOURCE_DIR=<ARCHIVE_SOURCE_DIR>
CYBERBOSS_ARCHIVE_DIR=<ARCHIVE_OUTPUT_DIR>

# Optional legacy Telegram proxy compatibility. Leave unset for normal Phase 1 startup.
# CYBERBOSS_TELEGRAM_PROXY_URL=<TELEGRAM_PROXY_URL>
