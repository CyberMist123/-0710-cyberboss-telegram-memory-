# Copy this file to your private config directory as .env.
# Values are placeholders; do not commit real tokens or local private paths.

CYBERBOSS_CONFIG_DIR=<CONFIG_DIR>
CYBERBOSS_STATE_DIR=<STATE_DIR>
CYBERBOSS_WORKSPACE=<WORKSPACE>
CYBERBOSS_PROMPT_FILE=<REPO_ROOT>/templates/weixin-instructions.md

CYBERBOSS_CHANNEL=telegram
CYBERBOSS_RUNTIME=claudecode
CYBERBOSS_CLAUDE_COMMAND=claude
CYBERBOSS_CLAUDE_MODEL=<MODEL>
CYBERBOSS_CLAUDE_PERMISSION_MODE=default
CYBERBOSS_CLAUDE_CONFIG_DIR=<CLAUDE_CONFIG_DIR>
# Leave blank to follow the host timezone; set an IANA name to override. Affects sleep quiet hours and AI time reporting.
CYBERBOSS_TIMEZONE=
DEEPSEEK_API_KEY=
# Never commit a value here. Export DEEPSEEK_API_KEY in the launching process.

CYBERBOSS_TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>
CYBERBOSS_TELEGRAM_ALLOWED_USER_IDS=<TELEGRAM_ALLOWED_USER_IDS>
CYBERBOSS_MEDIA_INBOX_MAX_BYTES=20971520
# Local Whisper is opt-in and never downloads a model automatically.
CYBERBOSS_LOCAL_WHISPER_ENABLED=false
# Reuse CMX's Python environment so faster-whisper and CTranslate2 are already installed.
# CYBERBOSS_LOCAL_WHISPER_PYTHON=<CMX_VENV>/Scripts/python.exe
# Reuse CMX's existing local CTranslate2 model directory instead of copying it:
# set this to the same path as CMX_WHISPER_MODEL_DIR.
# CYBERBOSS_LOCAL_WHISPER_MODEL=<CMX_WHISPER_MODEL_DIR>
# API STT is the production Telegram voice path. The key is supplied only in the
# private runtime env; never commit it here.
# CYBERBOSS_VOICE_KIT_DIR=<VOICE_KIT_DIR>
# CYBERBOSS_VOICE_STT_PROVIDER=openai-compatible
# CYBERBOSS_VOICE_STT_API_KEY=<OPENAI_API_KEY>
# CYBERBOSS_VOICE_STT_BASE_URL=https://api.openai.com/v1
# CYBERBOSS_VOICE_STT_MODEL=gpt-4o-transcribe
# CYBERBOSS_VOICE_STT_LANGUAGE=zh
# CYBERBOSS_LOCAL_WHISPER_DEVICE=cpu
# CYBERBOSS_LOCAL_WHISPER_COMPUTE_TYPE=int8
# CYBERBOSS_LOCAL_WHISPER_TIMEOUT_MS=120000
# CYBERBOSS_LOCAL_WHISPER_MAX_INPUT_BYTES=20971520
# CYBERBOSS_LOCAL_WHISPER_MAX_AUDIO_SECONDS=180
# CYBERBOSS_LOCAL_WHISPER_MAX_OUTPUT_CHARS=4000
# CYBERBOSS_LOCAL_WHISPER_MAX_STDERR_CHARS=4000

# Optional CMX image recognition/OCR for inbound Telegram photos.
# This remains disabled unless caption mode and the cmx-recognize provider are both explicit.
# Point the base URL at a CMX deployment that actually exposes POST /files/recognize;
# TG uploads saved image bytes and does not duplicate RapidOCR weights or the Gemini key.
# CYBERBOSS_VISION_MODE=caption
# CYBERBOSS_VISION_PROVIDER=cmx-recognize
# CYBERBOSS_VISION_API_BASE_URL=http://127.0.0.1:<CMX_PORT>
# Use a dedicated least-privilege bearer accepted by /files/recognize; never reuse an Owner/admin token when avoidable.
# CYBERBOSS_VISION_API_KEY=<CMX_BEARER_TOKEN>
# CYBERBOSS_VISION_TIMEOUT_MS=30000
# CYBERBOSS_VISION_MODEL is not used by cmx-recognize; CMX owns its OCR/Gemini provider choices.

CYBERBOSS_LOG_DIR=<STATE_DIR>/logs
CYBERBOSS_DASHBOARD_HOST=127.0.0.1
CYBERBOSS_DASHBOARD_PORT=<DASHBOARD_PORT>
CYBERBOSS_LOCATION_PORT=<LOCATION_PORT>
CYBERBOSS_BACKUP_DIR=<BACKUP_DIR>

# Phase 1 safety defaults: legacy memory side effects stay off unless explicitly re-enabled.
CYBERBOSS_MEMORY_RETRIEVAL=0
CYBERBOSS_MEMORY_BACKGROUND_WRITE=0
CYBERBOSS_MEMORY_REPLY_TRANSFORM=0
CYBERBOSS_INCLUDE_OPERATIONS_PROMPT=0
CYBERBOSS_INCLUDE_LEGACY_MEMORY_RELAYS=0
CYBERBOSS_DESIRE_DRIVEN=0
CYBERBOSS_DESIRE_LOOP_MINIMAL_ENABLED=0

# P0 closeout/liveness is deliberately off by default. These jobs use the
# existing ContinuityPipeline, writer lease, system-message queue, and
# Telegram delivery path; they never alter the ordinary chat path when off.
CYBERBOSS_NIGHTLY_CLOSEOUT_ENABLED=false
# Review envelope/case materialization is opt-in until the remaining G2 handoff path lands.
CYBERBOSS_REVIEW_ARTIFACTS_ENABLED=false
# G2-5 handoff dispatch/injection/ack is separately opt-in and defaults closed.
CYBERBOSS_HANDOFF_DISPATCH_ENABLED=false
CYBERBOSS_SUBJECT_SIGNING_ENABLED=false
# No consumer is wired yet; any future companion reader must honor this gate.
CYBERBOSS_LEGACY_CANDIDATE_BINDING_ENABLED=false
# E1 慢层注入面：三项独立开关默认关（=1 开）。开着才在开窗时小预算缝入
# agreements / ai-portrait / wandering，三项合计 ≤800 非空白字，超限逐项跳过（fail-open）。
CYBERBOSS_INJECT_AGREEMENTS=0
CYBERBOSS_INJECT_PORTRAIT=0
CYBERBOSS_INJECT_WANDERING=0
# Subject beats are opt-in; values use the automation timezone below.
CYBERBOSS_CONSOLIDATION_TRIGGER_ENABLED=0
CYBERBOSS_CONSOLIDATION_HOUR=21
CYBERBOSS_CONSOLIDATION_MINUTE=30
CYBERBOSS_REFLECT_TRIGGER_ENABLED=0
CYBERBOSS_REFLECT_INTERVAL_DAYS=3
CYBERBOSS_REFLECT_HOUR=20
CYBERBOSS_REFLECT_MINUTE=30
# 三份文件的位置：portrait 不设时缺省 <CYBERBOSS_MEMORY_DIR>/ai_self_portrait.md；
# agreements 与 wandering 无缺省，不设 = 该项静默跳过。
# CYBERBOSS_AGREEMENTS_FILE=<SELFHOOD_DIR>/03-evolving-self/agreements.md
# CYBERBOSS_AI_PORTRAIT_FILE=<MEMORY_DIR>/ai_self_portrait.md
# CYBERBOSS_WANDERING_FILE=<SELFHOOD_DIR>/02-wandering/wandering-question.md
# Valid modes: evidence, shadow, auto. Default is evidence; only auto writes canonical history.
CYBERBOSS_NIGHTLY_MODE=evidence
CYBERBOSS_NIGHTLY_CLOSEOUT_HOUR=4
CYBERBOSS_NIGHTLY_CLOSEOUT_MINUTE=30
CYBERBOSS_AUTOMATION_TIMEZONE=Australia/Sydney
CYBERBOSS_CANON_LIVENESS_ENABLED=false
CYBERBOSS_CANON_LIVENESS_THRESHOLD_HOURS=48
CYBERBOSS_RECALL_LIVENESS_ENABLED=false
CYBERBOSS_RECALL_LIVENESS_THRESHOLD_HOURS=48
CYBERBOSS_LIVENESS_STARTUP_GRACE_MINUTES=30
CYBERBOSS_LIVENESS_ALERT_COOLDOWN_HOURS=24
CYBERBOSS_LIVENESS_RECOVERY_ENABLED=true
CYBERBOSS_CLAUDE_TRANSCRIPT_DIR=<CLAUDE_TRANSCRIPT_DIR>
CYBERBOSS_MEMORY_DIR=<STATE_DIR>/memory

# 聊天资产的独立根（可选）。不设时各自回落到 CYBERBOSS_CHAT_ASSETS_DIR（缺省 = STATE_DIR）
# 下的派生路径，与设它们之前逐字节一致；设某一行只把那一类搬走，互不牵连。
# CYBERBOSS_CHAT_ASSETS_DIR 一次搬走全部四类（含日记）；下面三行按需分头细化：
#   CYBERBOSS_CONVERSATIONS_DIR=<CHAT_ASSETS_DIR>/conversations   聊天原文
#   CYBERBOSS_MEDIA_DIR=<CHAT_ASSETS_DIR>/media                   收到的媒体（下辖 voice/ photos/）
#   CYBERBOSS_STICKERS_DIR=<CHAT_ASSETS_DIR>/stickers             表情包（含 assets/ index.json/ tags.json）
# 日记单独由 CYBERBOSS_DIARY_DIR 覆盖（缺省 <CHAT_ASSETS_DIR>/diary）。

# Phase 1 switch safety: export this in the CURRENT PowerShell process before running
# phase1-switch.ps1. The switch preflight intentionally does not load this value from .env.
# $env:CYBERBOSS_NON_TELEGRAM_PID_ALLOWLIST='<WECHAT_CYBERBOSS_PID>'

# Optional external/archive features.
CYBERBOSS_ARCHIVE_BUILDER_PATH=<ARCHIVE_BUILDER_PATH>
CYBERBOSS_ARCHIVE_SOURCE_DIR=<ARCHIVE_SOURCE_DIR>
CYBERBOSS_ARCHIVE_DIR=<ARCHIVE_OUTPUT_DIR>

# Optional legacy Telegram proxy compatibility. Leave unset for normal Phase 1 startup.
# CYBERBOSS_TELEGRAM_PROXY_URL=<TELEGRAM_PROXY_URL>

# Apple Watch health bridge (read-only `health` catalog tool under 感知).
# Default OFF; the tool registers only when this is truthy (1/true/yes/on).
CYBERBOSS_HEALTH_ENABLED=false
# Python interpreter that can run the Collar_watch health_store module.
# CYBERBOSS_HEALTH_PYTHON=<PYTHON_EXE>
# The Collar_watch `server/` directory (holds health_store.py); used as the
# child cwd/PYTHONPATH so `import health_store` resolves.
# CYBERBOSS_HEALTH_SERVER_DIR=<COLLAR_WATCH_SERVER_DIR>
# The health data store directory; forwarded to the child as HEALTH_DATA_DIR.
# Unset falls back to health_store's own default (./data/health).
# HEALTH_DATA_DIR=<COLLAR_WATCH_HEALTH_DATA_DIR>
