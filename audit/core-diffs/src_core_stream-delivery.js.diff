@@ -24,6 +24,32 @@ class StreamDelivery {
     this.deferredReplyPrefixByBindingKey = new Map();
     this.stateByRunKey = new Map();
     this.runSequence = 0;
+    // 短 TTL 出站去重:同一 (userId + text) 在 3 秒内被要求发第二次 → 丢掉。
+    // 治「一条输入 → assistant.text 和 turn.completed 各触发一次 sendText」的重复回复。
+    // 只对 telegram 生效,不影响微信;文本不同则不 dedupe(避免吞真的连发)。
+    this.recentTelegramOutboundByKey = new Map();
+    this.telegramOutboundDedupeTtlMs = 3_000;
+  }
+
+  shouldDropDuplicateTelegramOutbound(payload) {
+    const userId = String(payload?.userId || "").trim();
+    const text = String(payload?.text || "").trim();
+    if (!userId || !text) return false;
+    const now = Date.now();
+    // 顺手清过期
+    for (const [key, expiresAt] of this.recentTelegramOutboundByKey.entries()) {
+      if (!Number.isFinite(expiresAt) || expiresAt <= now) {
+        this.recentTelegramOutboundByKey.delete(key);
+      }
+    }
+    const key = `${userId}:${text.slice(0, 4000)}`;
+    const existing = this.recentTelegramOutboundByKey.get(key);
+    if (existing && existing > now) {
+      console.warn(`[cyberboss] drop duplicate outbound telegram text user=${userId} preview=${JSON.stringify(text.slice(0, 120))}`);
+      return true;
+    }
+    this.recentTelegramOutboundByKey.set(key, now + this.telegramOutboundDedupeTtlMs);
+    return false;
   }
 
