+function persistDesireStateSnapshot(config = {}, state = {}, { source = "" } = {}) {
+  const stateFile = normalizeText(config?.desireStateFile);
+  if (!stateFile || !state || typeof state !== "object") {
+    return null;
+  }
+  const drives = normalizeDesireDrives(state?.drives);
+  if (!Array.isArray(drives) || !drives.length) {
+    return null;
+  }
+  const intent = normalizeDesireIntent(state?.intent);
+  const now = new Date().toISOString();
+  let previous = null;
+  try {
+    const raw = JSON.parse(fs.readFileSync(stateFile, "utf8"));
+    if (raw?.drives && raw.updatedAt !== now) {
+      previous = { drives: raw.drives, updatedAt: raw.updatedAt };
+    }
+  } catch {}
+  const payload = {
+    ...state,
+    drives,
+    intent,
+    previous,
+    updatedAt: now,
+  };
+  fs.mkdirSync(path.dirname(stateFile), { recursive: true });
+  fs.writeFileSync(stateFile, JSON.stringify(payload, null, 2));
+  appendDesireHistorySnapshot(resolveDesireHistoryFile(config), payload, source);
+  return payload;
+}
