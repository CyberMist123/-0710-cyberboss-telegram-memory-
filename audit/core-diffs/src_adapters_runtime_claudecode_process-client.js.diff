     console.log(
-      `[claudecode-runtime] launching command=${this.command} cwd=${this.cwd} mcp_config=${mcpLabel}`
+      `[claudecode-runtime] launching command=${this.command} ext=${getCommandExtension(this.command)} shell=${requiresWindowsShell} cwd=${this.cwd} mcp_config=${mcpLabel}`
     );
