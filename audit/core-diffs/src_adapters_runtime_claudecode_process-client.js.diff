@@ -164,6 +182,7 @@ class ClaudeCodeProcessClient {
       if (!item || typeof item !== "object") continue;
       const itemType = item.type;
       if (itemType === "text" && typeof item.text === "string" && item.text) {
+        if (isClaudeCliNoise(item.text)) continue;
         this.emit({
           type: "assistant.text",
           text: item.text.trim(),
@@ -441,4 +460,13 @@ function isPotentiallySensitive(text) {
   return SENSITIVE_KEYWORDS.test(text) || SENSITIVE_PATTERNS.test(text);
 }
 
+function getCommandExtension(command) {
+  const normalized = typeof command === "string" ? command.trim() : "";
+  if (!normalized) {
+    return "(none)";
+  }
+  const match = /\.([a-z0-9]+)$/i.exec(normalized);
+  return match ? `.${match[1].toLowerCase()}` : "(none)";
+}
+
 module.exports = { ClaudeCodeProcessClient };
