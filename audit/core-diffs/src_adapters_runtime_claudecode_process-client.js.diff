 const { spawn } = require("child_process");
 
+// Claude Code CLI 在 stream 中间可能吐 warning(比如自建端点上的模型名不在
+// Anthropic 官方列表)。这些 warning 走 assistant.text 事件,和真回复混发到 TG,
+// 用户看到「一句提问 → 两条回复」。这里只过滤中间流,不动 handleResult。
+// 万一 result.text 本身就是 noise,说明这轮 claude.exe 没真回复,照常让 turn 结束、
+// 让 noise 送到用户面前,别悄悄吞。
+const CLAUDE_CLI_NOISE_PATTERNS = [
+  /There's an issue with the selected model.*may not exist.*Run --model/i,
+  /Invalid API key\s*·\s*Fix external API key/i,
+];
+function isClaudeCliNoise(text) {
+  const s = typeof text === "string" ? text.trim() : "";
+  if (!s) return false;
+  return CLAUDE_CLI_NOISE_PATTERNS.some((re) => re.test(s));
+}
+
 class ClaudeCodeProcessClient {
   constructor({ command = "claude", cwd, env, model = "", permissionMode = "default", disableVerbose = false, extraArgs = [], mcpConfigPaths = [], ipcServer = null, workspaceRoot = "" }) {
     this.command = command;
@@ -60,14 +75,17 @@ class ClaudeCodeProcessClient {
     const mcpLabel = this.mcpConfigPaths.length
